{
  "id": "monzo-addon",
  "name": "Monzo Bank Integration",
  "version": "1.0.0",
  "description": "Automatically sync transactions from your Monzo bank account into Wealthfolio",
  "author": "Wealthfolio",
  "main": "dist/addon.js",
  "sdkVersion": "3.3.0",
  "enabled": true,
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll", "create"],
      "purpose": "Map Monzo accounts to Wealthfolio accounts"
    },
    {
      "category": "activities",
      "functions": ["import", "checkImport"],
      "purpose": "Import transactions as activities"
    },
    {
      "category": "secrets",
      "functions": ["set", "get", "delete"],
      "purpose": "Store OAuth tokens securely"
    },
    {
      "category": "ui",
      "functions": ["sidebar.addItem", "router.add"],
      "purpose": "Add navigation and routing for the addon interface"
    }
  ]
}
